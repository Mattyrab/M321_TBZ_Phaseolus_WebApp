@page
@model WebApp.Pages.BeansModel
@{
    ViewData["Title"] = "Beans";
}

<div class="mb-4">
    <h1>Bean Meals</h1>
    @if (Model.AddedMessage is not null)
    {
        <div class="alert alert-success">@Model.AddedMessage</div>
    }
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model.Menu)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text flex-grow-1">@item.Description</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="card-text fw-bold">$@item.Price.ToString("F2")</span>
                    </div>
                    <form method="post" asp-page-handler="AddToCart" class="mt-3">
                        <input type="hidden" name="name" value="@item.Name" />
                        <input type="hidden" name="price" value="@item.Price" />
                        <button type="submit" class="btn btn-primary w-100">Add to Cart</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<div class="mt-5">
    <a asp-page="/Cart" class="btn btn-outline-primary">← View Cart</a>
</div>
