@page
@model WebApp.Pages.BeansModel
@{
    ViewData["Title"] = "Beans";
}

<h1>Bean Meals</h1>

@if (Model.AddedMessage is not null)
{
    <div class="alert alert-success">@Model.AddedMessage</div>
}

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model.Menu)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text">@item.Description</p>
                    <p class="card-text fw-bold">$@item.Price.ToString("F2")</p>
                    <form method="post" asp-page-handler="AddToCart" class="mt-auto">
                        <input type="hidden" name="name" value="@item.Name" />
                        <input type="hidden" name="price" value="@item.Price" />
                        <button type="submit" class="btn btn-primary">Add to Cart</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<p class="mt-3"><a asp-page="/Cart">View Cart</a></p>
