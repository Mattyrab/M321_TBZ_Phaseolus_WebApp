@page
@model WebApp.Pages.CheckoutModel
@{
    ViewData["Title"] = "Checkout";
}

<h1>Checkout</h1>

@if (Model.ResultMessage is not null)
{
    <div class="alert @(Model.OrderSucceeded ? "alert-success" : "alert-danger")">
        @Model.ResultMessage
    </div>
}

@if (!Model.OrderSucceeded)
{
    <div class="row">
        <div class="col-lg-8">
            <h3 class="mb-4">Order Summary</h3>
            <div class="table-responsive mb-4">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Quantity</th>
                            <th>Line total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td>@line.Name</td>
                                <td>@line.Quantity</td>
                                <td><strong>$@line.LineTotal.ToString("F2")</strong></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="2" class="text-end">Total Amount</th>
                            <th><strong class="text-primary">$@Model.Total.ToString("F2")</strong></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="col-lg-4">
            <h3 class="mb-4">Delivery Information</h3>
            <form method="post" asp-page-handler="Pay">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="DeliveryNote" class="form-label">Delivery Note (optional)</label>
                    <textarea asp-for="DeliveryNote" class="form-control" placeholder="e.g. extra spicy" rows="4"></textarea>
                    <small class="text-muted">Add any special instructions for delivery</small>
                </div>
                <button type="submit" class="btn btn-primary w-100">Complete Payment</button>
                <a asp-page="/Cart" class="btn btn-outline-secondary w-100 mt-2">← Back to Cart</a>
            </form>
        </div>
    </div>
}
