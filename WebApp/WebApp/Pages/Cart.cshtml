@page
@model WebApp.Pages.CartModel
@{
    ViewData["Title"] = "Cart";
}

<h1>Your Cart</h1>

@if (Model.ResultMessage is not null)
{
    <div class="alert @(Model.OrderSucceeded ? "alert-success" : "alert-danger")">
        @Model.ResultMessage
    </div>
}

@if (Model.Lines.Count == 0)
{
    <p>Your cart is empty. <a asp-page="/Beans">Browse beans</a>.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Item</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Line total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td>@line.Name</td>
                    <td>$@line.Price.ToString("F2")</td>
                    <td>@line.Quantity</td>
                    <td>$@line.LineTotal.ToString("F2")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3">Total</th>
                <th>$@Model.Total.ToString("F2")</th>
            </tr>
        </tfoot>
    </table>

    <form method="post" asp-page-handler="Checkout">
        <button type="submit" class="btn btn-primary">Place order</button>
    </form>
}
