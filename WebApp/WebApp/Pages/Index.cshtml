@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<section class="hero-section">
    <h1>Phaseolus Express</h1>
    <p>Welcome to Phaseolus Express online order service!</p>
</section>

<div class="row g-4">
    <div class="col-sm-6">
        <div class="card text-center h-100">
            <div class="card-body">
                <h5 class="card-title">🫘 Show Me Them Beans</h5>
                <p class="card-text">View our assortment of the finest beans known to man.</p>
                <a asp-page="/Beans" class="btn btn-primary">View beans</a>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card text-center h-100">
            <div class="card-body">
                <h5 class="card-title">🛒 Bring Me The Cart</h5>
                <p class="card-text">View your cart and check out.</p>
                <a asp-page="/Cart" class="btn btn-primary">View cart</a>
            </div>
        </div>
    </div>
</div>